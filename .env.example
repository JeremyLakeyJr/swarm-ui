# Swarm UI Configuration
# Copy this file to .env and fill in the values

# ---- Application ----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=change-me-to-a-random-secret
APP_DEBUG=false

# ---- Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Autogen ----
AUTOGEN_DEFAULT_LLM_PROVIDER=ollama
AUTOGEN_MAX_ROUNDS=10
AUTOGEN_TIMEOUT=120

# ---- Home Assistant ----
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=your-long-lived-access-token

# ---- OpenClaw ----
OPENCLAW_BASE_URL=http://localhost:9000
OPENCLAW_API_KEY=your-openclaw-api-key

# ---- Microsoft Agent Framework ----
AGENT_FRAMEWORK_BASE_URL=http://localhost:11434
AGENT_FRAMEWORK_MODEL=llama3
AGENT_FRAMEWORK_API_KEY=
